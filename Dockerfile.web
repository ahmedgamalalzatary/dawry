# Build from the repo root:  docker build -f Dockerfile.web --build-arg API_INTERNAL_URL=http://api:4000 .
FROM node:24-alpine AS base
RUN npm install -g pnpm@12.4.1
WORKDIR /repo

FROM base AS build
# The /api/* proxy target is fixed when Next.js builds its routes.
ARG API_INTERNAL_URL=http://api:4000
ENV API_INTERNAL_URL=$API_INTERNAL_URL
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@dawry/web
# public/ is optional (git drops empty folders); make sure the COPY below has a source.
RUN mkdir -p apps/web/public

FROM node:24-alpine AS runtime
ARG API_INTERNAL_URL=http://api:4000
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 API_INTERNAL_URL=$API_INTERNAL_URL
WORKDIR /app
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
