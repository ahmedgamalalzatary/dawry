# Copy to .env at the repo root (and .env.test for tests, with a *_test database).
# apps/api and apps/web both read the root file. Never commit real values.

# api
DATABASE_URL=mysql://root:password@localhost:3306/dawry
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# web
NEXT_PUBLIC_API_URL=http://localhost:4000

# production only (docker-compose.yml builds DATABASE_URL from these)
MYSQL_DATABASE=dawry
MYSQL_USER=dawry
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
